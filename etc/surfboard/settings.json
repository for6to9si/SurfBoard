{
    "xwayConf":
    {
        "isEnabled": true,
        "paths":
        {
            "xrayExecutable": "/opt/sbin/xray",
            "xrayRestart": "/opt/etc/init.d/S98xray fast_restart",
            "xrayStart": "/opt/etc/init.d/S98xray start",
            "xrayStop": "/opt/etc/init.d/S98xray stop",
            "xrayStatus": "/opt/etc/init.d/S98xray status",
            "xraylockFile": "/opt/tmp/xray-xwave.lock"
        },
        "env":
        {
            "XRAY_LOCATION_ASSET": "/opt/etc/xray/dat",
            "XRAY_LOCATION_CONFDIR": "/opt/etc/xray/configs",
            "XRAY_LOCATION_TEMPLATEDIR": "/opt/etc/xray/template",
            "XRAY_RAY_BUFFER_SIZE": 4
        },
        "grpc":
        {
            "target":
            {
                "ip": "127.0.0.1",
                "port": 10085
            }
        }
    },
    "swayConf":
    {
        "isEnabled": true,
        "paths":
        {
            "singboxExecutable": "/opt/sbin/sing-box",
            "singboxRestart": "/opt/etc/init.d/S99singbox fast_restart",
            "singboxStart": "/opt/etc/init.d/S99singbox start",
            "singboxStop": "/opt/etc/init.d/S99singbox stop",
            "singboxStatus": "/opt/etc/init.d/S99singbox status",
            "singboxlockFile": "/opt/tmp/S99singbox-sway.lock"
        },
        "env":
        {
            "SSL_CERT_DIR": "/opt/etc/ssl/certs",
            "SINGBOX_LOCATION_CONFDIR": "/opt/etc/sing-box/configs"
        }
    },
    "benchmarkSettings":
    {
        "isEnabled": true,
        "autostart": true,
        "paths":
        {
            "xrayExecutable": "/opt/sbin/xray",
            "xraylockFile": "/opt/tmp/xray-surfboard.lock"
        },
        "env":
        {
            "XRAY_LOCATION_ASSET": "/opt/etc/surfboard/benchmark/xray/dat",
            "XRAY_LOCATION_CONFDIR": "/opt/etc/surfboard/benchmark/xray/configs",
            "XRAY_LOCATION_TEMPLATEDIR": "/opt/etc/surfboard/benchmark/xray/templates",
            "XRAY_RAY_BUFFER_SIZE": 4
        },
        "grpc":
        {
            "target":
            {
                "ip": "127.0.0.1",
                "port": 10085
            }
        },
        "openAI": {
            "isEnabled": true,
            "apikey": "sk-proj-EW_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX",
            "url": "https://api.openai.com/v1/chat/completions",
            "statusCodes": {
                "geoBlocked": 403,
                "retryableErrors": [429, 503],
                "allowed": [200, 204]
            }
        }
    },
    "tgBot":
    {
        "TOKEN": "aaaaaa:AAdp9_PB-d7pm_5ido",
        "adminIds":
        [
            1111111,
            2222222
        ]
    },
    "installer":
    {
        "isEnabled": true,
        "programs":
        {
            "xray":
            {
                "executablePath": "/opt/sbin/xray",
                "args":["version"],
                "update_url": "https://api.github.com/repos/for6to9si/X-wave/releases/latest",
                "isEnabled": true
            },
            "sing-box":
            {
                "executablePath": "/opt/sbin/sing-box",
                "args":["version"],
                "update_url": "https://api.github.com/repos/for6to9si/S-wave/releases/latest",
                "isEnabled": true
            },
            "surfBoard":
            {
                "executablePath": "/opt/sbin/surfboard",
                "args":["-version"],
                "update_url": "https://api.github.com/repos/for6to9si/SurfBoard/releases/latest",
                "isEnabled": true
            },
            "youtubeUnblock":
            {
                "executablePath": "/opt/bin/youtubeUnblock",
                "args":["--version"],
                "update_url": "https://api.github.com/repos/Waujito/youtubeUnblock/releases/latest",
                "isEnabled": true
            },
            "nfqws":
            {
                "executablePath": "/opt/usr/bin/nfqws",
                "args":["--version"],
                "update_url": "https://api.github.com/repos/Anonym-tsk/nfqws-keenetic/releases/latest",
                "isEnabled": false
            }
        }
    }
}