            "xrayExecutable": "/opt/sbin/xray",
            "xraylockFile": "/opt/tmp/xray-surfboard.lock"
        },
        "env":
        {
            "XRAY_LOCATION_ASSET": "/opt/etc/surfboard/benchmark/xray/dat",
            "XRAY_LOCATION_CONFDIR": "/opt/etc/surfboard/benchmark/xray/configs",
            "XRAY_LOCATION_TEMPLATEDIR": "/opt/etc/surfboard/benchmark/xray/templates",
            "XRAY_RAY_BUFFER_SIZE": 4
        },
        "grpc":
        {
            "target":
            {
                "ip": "127.0.0.1",
                "port": 10085
            }
        },
        "openAI": {
            "isEnabled": true,
