    "installer":
    {
        "isEnabled": true,
        "programs":
        {
            "xray":
            {
                "executablePath": "/opt/sbin/xray",
                "args":["version"],
                "repo": "for6to9si/X-wave",
                "arch_patterns": {
                  "amd64": "(?i)(amd64).*?\\.(ipk|tar\\.gz)$",
                  "i386": "(?i)(i386).*?\\.(ipk|tar\\.gz)$",
                  "arm64": "(?i)(arm64|aarch64).*?\\.(ipk|tar\\.gz)$",
                  "mipsle": "(?i)(mips32le|mipsle).*?\\.(ipk|tar\\.gz)$",
                  "mips": "(?i)mips(32|64)\\.(?:.*\\.)?(?:ipk|tar\\.gz)$"
                },
                "only_release": true,
                "service_commands": [
                  "/opt/etc/init.d/S98xray restart",
                  "/opt/etc/init.d/S98xray firewall_up"
                ],
                "isEnabled": true
            },
            "sing-box":
            {
                "executablePath": "/opt/sbin/sing-box",
                "args":["version"],
                "repo": "for6to9si/S-wave",
                "arch_patterns": {
                  "amd64": "(?i)(amd64).*?\\.(ipk|tar\\.gz)$",
                  "i386": "(?i)(i386).*?\\.(ipk|tar\\.gz)$",
                  "arm64": "(?i)(arm64|aarch64).*?\\.(ipk|tar\\.gz)$",
                  "mipsle": "(?i)(mipsel|mipsle).*?\\.(ipk|tar\\.gz)$",
                  "mips": "(?i)(^|[-_.])mips([-_.]|$).*?\\.(ipk|tar\\.gz)$"
                },
                "only_release": true,
                "service_commands": [
                  "/opt/etc/init.d/S99sing-box restart",
                  "/opt/etc/init.d/S99sing-box firewall_up"
                ],
                "isEnabled": true
            },
            "surfBoard":
            {
                "executablePath": "/opt/sbin/surfboard",
                "args":["-version"],
                "repo": "for6to9si/SurfBoard",
                "arch_patterns": {
                  "amd64": "(?i)(amd64).*?\\.(ipk|tar\\.gz)$",
                  "i386": "(?i)(i386).*?\\.(ipk|tar\\.gz)$",
                  "arm64": "(?i)(arm64|aarch64).*?\\.(ipk|tar\\.gz)$",
                  "mipsle": "(?i)(mipsel|mipsle).*?\\.(ipk|tar\\.gz)$",
                  "mips": "(?i)mips\\.(?:.*\\.)?(?:ipk|tar\\.gz)$"
                },
                "isEnabled": true,
                "service_commands": ["/home/andrew/work/for6to9si/telegram/SurfBoard/build/surfboard-amd64 -version"],
                "only_release": true
            },
            "youtubeUnblock":
            {
                "executablePath": "/opt/bin/youtubeUnblock",
                "args":["--version"],
                "repo": "Waujito/youtubeUnblock",
                "arch_patterns": {
                  "arm64": "(?i)(entware.*aarch64).*?\\.(ipk|tar\\.gz)$",
                  "mipsle": "(?i)(entware.*(mipsel|mipsle)).*?\\.(ipk|tar\\.gz)$",
                  "mips": "(?i)entware.*\\bmips\\b.*?\\.(ipk|tar\\.gz)$"
                },
                "only_release": true,
                "service_commands": ["/opt/etc/init.d/S91youtubeUnblock restart"],
                "isEnabled": true
            },
            "nfqws":
            {
                "executablePath": "/opt/usr/bin/nfqws",
                "args":["--version"],
                "repo": "Anonym-tsk/nfqws-keenetic",
                "arch_patterns": {
                  "mipsle": "(?i)(mipsel|mipsle).*?\\.(ipk|tar\\.gz)$",
                  "mips": "(?i)(^|[-_.])mips([-_.]|$).*?\\.(ipk|tar\\.gz)$"
                },
                "only_release": true,
                "isEnabled": false
            }
        }
    }
}